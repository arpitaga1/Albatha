# Local dev needs nothing here - Vite's dev server proxies /api to the
# local backend (see vite.config.ts), so leave this unset.
#
# For a production deploy (Vercel), set this in the project's Environment
# Variables to the deployed backend's URL, no trailing slash:
# VITE_API_BASE_URL=https://albatha-mpc-backend.onrender.com
VITE_API_BASE_URL=
